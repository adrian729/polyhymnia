    "mnx:update": "node scripts/mnx-update.mjs",
    "gen:mnx-types": "node scripts/gen-mnx-types.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "fast-check": "^3.23.0",
    "json-schema-to-typescript": "16.0.0",
    "ajv": "8.20.0",
    "@types/node": "^26.6.2"
  }
}
