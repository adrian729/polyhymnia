{
  "name": "@polyhymnia/musicxml-to-mnx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "musicxml-to-mnx": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
